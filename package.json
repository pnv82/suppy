    "jose": "6.2.12",
    "leaflet": "^1.9.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "vite": "6.4.2",
    "zod": "^4.6.5"
